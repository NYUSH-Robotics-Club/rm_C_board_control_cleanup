# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.s text eol=lf
*.S text eol=lf

# Scripts
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.ioc text eol=lf

# CMake files
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Makefiles
Makefile text eol=lf
*.mk text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files (explicitly marked to prevent conversion)
*.bin binary
*.hex binary
*.elf binary
*.o binary
*.a binary
*.lib binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svd binary


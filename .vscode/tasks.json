{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "robotType",
      "type": "pickString",
      "description": "Choose robot configuration",
      "options": [
        "infantry_standard",
        "sentry_swerve"
      ],
      "default": "infantry_standard"
    }
  ],
  "tasks": [
    {
      "label": "cmake: configure (choose robot)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${command:cmake.buildDirectory}",
        "-DROBOT_TYPE=${input:robotType}"
      ],
      "problemMatcher": []
    },
    {
      "label": "cmake: build",
      "type": "shell",
      "dependsOn": "cmake: configure (choose robot)",
      "dependsOrder": "sequence",
      "command": "cmake",
      "args": [
        "--build",
        "${command:cmake.buildDirectory}",
        "--"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "pack: elf -> bin",
      "type": "shell",
      "dependsOn": "cmake: build",
      "dependsOrder": "sequence",
      "command": "arm-none-eabi-objcopy",
      "args": [
        "-O",
        "binary",
        "${command:cmake.buildDirectory}/NYUSH_Infantry.elf",
        "${command:cmake.buildDirectory}/NYUSH_Infantry.bin"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash: dfu-util",
      "type": "shell",
      "dependsOn": "pack: elf -> bin",
      "dependsOrder": "sequence",
      "command": "dfu-util",
      "args": [
        "-a",
        "0",
        "-s",
        "0x08000000:leave",
        "-D",
        "${command:cmake.buildDirectory}/NYUSH_Infantry.bin"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "flash: stlink (CubeProgrammer)",
      "detail": "Uses the same checked ST-Link workflow as Firmware: Flash and just flash.",
      "type": "process",
      "command": "${config:firmware.justPath}",
      "args": [
        "flash"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": { "options": { "env": { "PATH": "${config:firmware.toolPath};${env:PATH}" } } },
      "osx": { "options": { "env": { "PATH": "${config:firmware.toolPath}:${env:PATH}" } } },
      "problemMatcher": []
    },
    {
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "options": {
          "env": {
            "PATH": "${config:firmware.toolPath}:${env:PATH}"
          }
        }
      },
      "problemMatcher": [],
      "args": [
        "doctor"
      ],
      "windows": {
        "options": {
          "env": {
            "PATH": "${config:firmware.toolPath};${env:PATH}"
          }
        }
      },
      "label": "Firmware: Doctor",
      "type": "process",
      "command": "${config:firmware.justPath}"
    },
    {
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "options": {
          "env": {
            "PATH": "${config:firmware.toolPath}:${env:PATH}"
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "args": [
        "build"
      ],
      "windows": {
        "options": {
          "env": {
            "PATH": "${config:firmware.toolPath};${env:PATH}"
          }
        }
      },
      "label": "Firmware: Build",
      "type": "process",
      "command": "${config:firmware.justPath}"
    },
    {
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "options": {
          "env": {
            "PATH": "${config:firmware.toolPath}:${env:PATH}"
          }
        }
      },
      "problemMatcher": [],
      "args": [
        "flash"
      ],
      "windows": {
        "options": {
          "env": {
            "PATH": "${config:firmware.toolPath};${env:PATH}"
          }
        }
      },
      "label": "Firmware: Flash",
      "type": "process",
      "command": "${config:firmware.justPath}"
    }
  ]
}
